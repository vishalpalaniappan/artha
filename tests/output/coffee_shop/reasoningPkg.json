            "fullPath": "designs/coffee_shop/coffee_shop.ar",
            "name": "coffee_shop.ar",
            "relativePath": "coffee_shop.ar",
            "content": "import(\"includes/user_choice.ar\")\nimport(\"participants/Cart.ar\")\n\nbehavior coffeeShop() {\n    introduce(\n        name= shopping_cart, \n        role= cart\n        participant= Cart\n    )\n    introduce(\n        name= menu, \n        role= menu\n        participant= menu\n    )\n    visitShop()\n}\n\nbehavior visitShop() {\n    baristaPresentsMenu()\n\n    acceptChoice(\n        alias = user_choice\n    )\n\n    checkIfUserChoseCoffee(\n        alias = user_chose_coffee,\n        choice = user_choice\n    )\n    if (condition = user_chose_coffee) {\n        addCoffeeToCart(\n            cart = shopping_cart\n        )\n        visitShop()\n    }\n\n\n    checkIfUserChoseBagel(\n        alias = user_chose_bagel,\n        choice = user_choice\n    )\n    if (condition = user_chose_bagel) {\n        addBagelToCart(\n            cart = shopping_cart\n        )\n        visitShop()\n    }\n\n\n    checkIfUserChoseDisplayCart(\n        alias = user_chose_display_cart,\n        choice = user_choice\n    )\n    if (condition = user_chose_display_cart) {\n        displayCart(\n            cart = shopping_cart\n        )\n        visitShop()\n    }\n\n\n    checkIfUserChoseClearCart(\n        alias = user_chose_clear_cart,\n        choice = user_choice\n    )\n    if (condition = user_chose_clear_cart) {\n        clearCart(\n            cart = shopping_cart\n        )\n        visitShop()\n    }\n}\n\nbehavior baristaPresentsMenu() {\n    terminal_display(\n        value = menu\n    )\n}\n\nbehavior acceptChoice() {\n    terminal_input(\n        alias = terminal_input\n    )\n    yield(value=terminal_input)\n}\n\nbehavior addCoffeeToCart(cart) {\n    insert_at_end_of_list(\n        value = \"Coffee\", \n        list = cart\n    )\n}\n\nbehavior addBagelToCart(cart) {\n    insert_at_end_of_list(\n        value = \"Bagel\", \n        list = cart\n    )\n}\n\nbehavior displayCart(cart) {\n    terminal_display(\n        value = cart\n    )\n}\n\nbehavior clearCart(cart) {\n    clear_list(\n        list = cart\n    )\n}\n\n",
