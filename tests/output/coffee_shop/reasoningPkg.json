        "fullPath": "designs/coffee_shop/coffee_shop.ar",
        "name": "coffee_shop.ar",
        "relativePath": "coffee_shop.ar",
        "content": "import(\"includes/user_choice.ar\")\nimport(\"participants/Cart.ar\")\n\nbehavior coffee_shop() {\n    introduce(\n        name= shopping_cart, \n        participant= Cart\n    )\n    visit_shop()\n}\n\nbehavior visit_shop() {\n    barista_presents_menu()\n\n    acceptChoice(\n        alias = user_choice\n    )\n\n    checkIfUserChoseCoffee(\n        alias = user_chose_coffee,\n        choice = user_choice\n    )\n    if (condition = user_chose_coffee) {\n        add_coffee_to_cart(\n            cart = shopping_cart\n        )\n        visit_shop()\n    }\n\n\n    checkIfUserChoseBagel(\n        alias = user_chose_bagel,\n        choice = user_choice\n    )\n    if (condition = user_chose_bagel) {\n        add_bagel_to_cart(\n            cart = shopping_cart\n        )\n        visit_shop()\n    }\n\n\n    checkIfUserChoseDisplayCart(\n        alias = user_chose_display_cart,\n        choice = user_choice\n    )\n    if (condition = user_chose_display_cart) {\n        display_cart(\n            cart = shopping_cart\n        )\n        visit_shop()\n    }\n\n\n    checkIfUserChoseClearCart(\n        alias = user_chose_clear_cart,\n        choice = user_choice\n    )\n    if (condition = user_chose_clear_cart) {\n        clear_cart(\n            cart = shopping_cart\n        )\n        visit_shop()\n    }\n}\n\nbehavior barista_presents_menu() {\n    display(\n        value = menu\n    )\n}\n\nbehavior acceptChoice() {\n    accept_terminal_input(\n        alias = terminal_input\n    )\n    yield(value=terminal_input)\n}\n\nbehavior add_coffee_to_cart(cart) {\n    insert_at_end(\n        value = \"Coffee\", \n        list = cart\n    )\n}\n\nbehavior add_bagel_to_cart(cart) {\n    insert_at_end(\n        value = \"Bagel\", \n        list = cart\n    )\n}\n\nbehavior display_cart(cart) {\n    display(\n        value = cart\n    )\n}\n\nbehavior clear_cart(cart) {\n    clear(\n        list = cart\n    )\n}\n\n",
