behavior coffee_shop() {
    introduce(
        name= shopping_cart, 
        participant= Cart
    )
    visit_shop()
}

behavior visit_shop() {
    barista_presents_menu()
    accept_choice(
        as = user_choice
    )
}

behavior barista_presents_menu() {
    display(
        value = menu
    )
}

behavior accept_choice() {
    accept_terminal_input(
        as = terminal_input
    )
    yield(value=terminal_input)
}

participant Cart() {
    structuralType(
        type= "list"
    )
    roleType(
        type= "basket"
    )
    contains(
        values= ["Coffee", "Bagel"]
    )
}