meaning of coffee shop {
    # TODO: populate coffee shop.
    # Create basket with bagels (subtract one per bagel bought).
    # Create pot of coffee (contains 8 cups of coffee).
    # Create Menu.

    present menu.
}

meaning of present menu {
    Barista presents the menu to the user then accept the menu choice from the user.
    if the user selected coffee, then add coffee to cart then present menu.
    if the user selected bagel, then add bagel to cart then present menu.
    if the user terminated the transaction, then clear the cart then present menu.
    if the user proceeded with the payment, then process payment then present menu.
}

meaning of accept menu choice from the user {
    accept terminal input and store in user_input.

    # TODO: Add errors after extending primitive syntax.
    # EOF is reached without data: present menu.
    # keyboard interrupt is triggered: close store.
}

meaning of close store {
    create message "Closing store. Gooddbye." of type string and store in msg.
    display msg in terminal.
}

meaning of Barista presents the menu to the user {
    get formatted menu and store in formatted_menu.
    display formatted_menu in terminal.
}

meaning of the user selected coffee {
    menu_choice equals "coffee" and store result in is_coffee.
    resolve is_coffee.
}

meaning of the user selected bagel {
    menu_choice equals "bagel" and store result in is_bagel.
    resolve is_bagel.
}

meaning of the user terminated the transaction {
    menu_choice equals "terminate" and store result in is_transaction.
    resolve is_transaction.
}

meaning of the user proceeded with the payment {
    menu_choice equals "checkout" and store result in is_payment.
    resolve is_payment.
}
