import("user_choice.ar")
import("participants/Cart.ar")

behavior coffee_shop() {
    introduce(
        name= shopping_cart, 
        participant= Cart
    )
    visit_shop()
}

behavior visit_shop() {
    barista_presents_menu()
    acceptChoice(
        alias = user_choice
    )

    checkIfUserChoseCoffee(
        alias = user_chose_coffee,
        choice = user_choice
    )    
    checkIfUserChoseBagel(
        alias = user_chose_bagel,
        choice = user_choice
    )
    checkIfUserChoseDisplayCart(
        alias = user_chose_display_cart,
        choice = user_choice
    )
    checkIfUserChoseClearCart(
        alias = user_chose_clear_cart,
        choice = user_choice
    )

    if (user_chose_coffee) {
        add_coffee_to_cart(
            cart = shopping_cart
        )
        visit_shop()
    }

    if (user_chose_bagel) {
        add_bagel_to_cart(
            cart = shopping_cart
        )
        visit_shop()
    }

    if (user_chose_display_cart) {
        display_cart(
            cart = shopping_cart
        )
        visit_shop()
    }

    if (user_chose_clear_cart) {
        clear_cart(
            cart = shopping_cart
        )
        visit_shop()
    }
}

behavior barista_presents_menu() {
    display(
        value = menu
    )
}

behavior acceptChoice() {
    accept_terminal_input(
        alias = terminal_input
    )
    yield(value=terminal_input)
}

behavior add_coffee_to_cart(cart) {
    insert_at_end(
        value = "Coffee", 
        list = cart
    )
}

behavior add_bagel_to_cart(cart) {
    insert_at_end(
        value = "Bagel", 
        list = cart
    )
}

behavior display_cart(cart) {
    display(
        value = cart
    )
}

behavior clear_cart(cart) {
    clear(
        list = cart
    )
}

