meaning of Coffee {
    it is a participant.

    it has structural type Object.
    it has role type Food Item.

    it has two attributes.
    it has an attribute named cost which is a float and has a value of 1,00. 
    it has an attribute named cost_currency which is a string and has a value of "CAD".
}

meaning of get cost of coffee {
    resolve attribute cost of Coffee.
}

meaning of get type of coffee {
    resolve attribute type of Coffee.
}

meaning of get currency of coffee cost {
    resolve attribute cost_currency of Coffee.
}