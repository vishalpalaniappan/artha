meaning of Coffee {
    it is a class.
    it has three attributes.
    it has an attribute named type that is a string and has a value of "food item".
    it has an attribute named cost which is a float and has a value of 1.00. 
    it has an attribute named cost_currency which is a string and has a value of "CAD".
    it has narratives "get type of coffee" and "get cost of coffee" and "get currency of coffee cost".
}

meaning of get cost of coffee {
    get attribute cost.
}

meaning of get type of coffee {
    get attribute type.
}

meaning of get currency of coffee cost {
    get attribute cost_currency.
}