meaning of Cart {
    it is a participant.
    it has structural type List.
    it has role type Inventory.
    it contain type Food Item.
}

meaning of add Coffee to Cart {
    # Cart only contains food_item, so there is an invariant that the item being inserted has to be of type food item.
    insert Coffee at end of Cart.
}

meaning of add Bagel to Cart {
    # Cart only contains food item, so there is an invariant that the item being inserted has to be of type food item.
    insert Bagel at end of Cart.
}

meaning of clear the Cart {
    # This is primitive that removes all the entries in the cart.
    remove all entires in Cart.
}