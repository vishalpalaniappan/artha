meaning of Menu {
    it is a participant.

    # Types.
    it has structural type List.
    it has role type menu_list.

    # Contains.
    it contains type String.

    # Initial Value.
    it has 1 entry with value "Coffee".
    it has 1 entry with value "Bagel".
    it has 1 entry with value "Clear Cart".
    it has 1 entry with value "Checkout".
}

get formatted Menu {
    # This is temporary, I'll create it from the menu list later.
    set formatted_menu to "Choose from: Coffee, Bagel, Clear Cart, Checkout" with type string.
    resolve formatted_menu.
}