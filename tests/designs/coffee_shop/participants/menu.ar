meaning of Menu {
    it is a participant.
    it has structural type List.
    it has role type Menu List.
    it contains type String.
    it has 1 option named "Coffee".
    it has 1 option named "Bagel".
    it has 1 option named "Clear Cart".
    it has 1 option named "Checkout".
}

get formatted Menu {
    set formatted_menu to "Choose from: Coffee, Bagel, Clear Cart, Checkout" with type string.
    resolve formatted_menu.
}