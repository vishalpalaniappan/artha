meaning of Bagel {
    it is a class.
    it has three attributes.
    it has an attribute named type that is a string and has a value of "food item".
    it has an attribute named cost which is a float and has a value of 2,00.
    it has an attribute named cost_currency which is a string and has a value of "CAD".
    it has narratives "get type of bagel" and "get cost of bagel" and "get currency of bagel cost".
}

meaning of get cost of bagel {
    resolve attribute cost.
}

meaning of get type of bagel {
    resolve attribute type.
}

meaning of get currency of bagel cost {
    resolve attribute cost_currency.
}