import("includes/user_choice.ar")
import("participants/Cart.ar")

behavior coffee_shop() {
    introduce(
        name= shopping_cart, 
        role= cart
        participant= Cart
    )
    introduce(
        name= menu, 
        role= menu
        participant= menu
    )
    visit_shop()
}

behavior visit_shop() {
    barista_presents_menu()

    acceptChoice(
        alias = user_choice
    )

    checkIfUserChoseCoffee(
        alias = user_chose_coffee,
        choice = user_choice
    )
    if (condition = user_chose_coffee) {
        add_coffee_to_cart(
            cart = shopping_cart
        )
        visit_shop()
    }


    checkIfUserChoseBagel(
        alias = user_chose_bagel,
        choice = user_choice
    )
    if (condition = user_chose_bagel) {
        add_bagel_to_cart(
            cart = shopping_cart
        )
        visit_shop()
    }


    checkIfUserChoseDisplayCart(
        alias = user_chose_display_cart,
        choice = user_choice
    )
    if (condition = user_chose_display_cart) {
        display_cart(
            cart = shopping_cart
        )
        visit_shop()
    }


    checkIfUserChoseClearCart(
        alias = user_chose_clear_cart,
        choice = user_choice
    )
    if (condition = user_chose_clear_cart) {
        clear_cart(
            cart = shopping_cart
        )
        visit_shop()
    }
}

behavior barista_presents_menu() {
    terminal_display(
        value = menu
    )
}

behavior acceptChoice() {
    terminal_input(
        alias = terminal_input
    )
    yield(value=terminal_input)
}

behavior add_coffee_to_cart(cart) {
    insert_at_end_of_list(
        value = "Coffee", 
        list = cart
    )
}

behavior add_bagel_to_cart(cart) {
    insert_at_end_of_list(
        value = "Bagel", 
        list = cart
    )
}

behavior display_cart(cart) {
    terminal_display(
        value = cart
    )
}

behavior clear_cart(cart) {
    clear_list(
        list = cart
    )
}

