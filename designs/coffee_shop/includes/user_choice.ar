behavior checkIfUserChoseBagel (user_choice) {
    equals(
        alias = user_chose_bagel,
        value1 = user_choice,
        value2 = "bagel"
    )
    yield(user_chose_bagel)
}

behavior checkIfUserChoseCoffee (user_choice) {
    equals(
        alias = did_user_chose_coffee,
        value1 = user_choice,
        value2 = "coffee"
    )
    yield(user_chose_coffee)
}

behavior checkIfUserChoseDisplayCart (user_choice) {
    equals(
        alias = did_user_choose_display_cart,
        value1 = user_choice,
        value2 = "view"
    )
    yield(did_user_choose_display_cart)
}

behavior checkIfUserChoseClearCart (user_choice) {
    equals(
        alias = did_user_choose_clear_cart,
        value1 = user_choice,
        value2 = "clear"
    )
    yield(did_user_choose_clear_cart)
}